{% extends 'base.html.twig' %}

{% block title %}Mesurement{% endblock %}

{% block body %}
    <h1>Mesurement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ mesurement.id }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ mesurement.location.city }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ mesurement.date ? mesurement.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Celsius</th>
                <td>{{ mesurement.celsius }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_mesurement_index') }}">back to list</a>
    {% if is_granted('ROLE_MESUREMENT_EDIT') %}
        <a href="{{ path('app_mesurement_edit', {'id': mesurement.id}) }}">edit</a>
    {% endif %}
    {% if is_granted('ROLE_MESUREMENT_DELETE') %}
        {{ include('mesurement/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
